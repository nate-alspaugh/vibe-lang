{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(obj\\s|do\\s|starting_attributes:|http\\.\\w+\\(|if\\s|otherwise|for each\\s|keep going until\\s|do \\d+ times|then\\s*$|filter\\(s\\):|maybe:)",
    "decreaseIndentPattern": "^\\s*(end|otherwise)\\b"
  },
  "folding": {
    "markers": {
      "start": "^\\s*(obj|do|starting_attributes:)\\b",
      "end": "^\\s*end\\b"
    }
  }
}
